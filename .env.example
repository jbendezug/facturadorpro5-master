# =============================================================================
# Facturador Pro 6 - Configuracion para Produccion
# =============================================================================
# Copiar a .env y ajustar los valores marcados con CAMBIA_*
# Comandos post-instalacion:
#   php artisan key:generate
#   php artisan storage:link
#   php artisan migrate --force
#   php artisan config:cache
# =============================================================================

# ── Aplicacion ───────────────────────────────────────────────────────────────
APP_NAME="FacturadorPro6"
APP_ENV=production
APP_DEBUG=false
APP_KEY=                              # CAMBIA: php artisan key:generate --show
APP_URL_BASE=midominio.com            # CAMBIA: tu dominio
APP_URL=https://midominio.com         # CAMBIA: misma URL

LOG_CHANNEL=daily

# ── Base de Datos (contenedor interno) ──────────────────────────────────────
DB_CONNECTION=system
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tenancy
DB_USERNAME=root
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA     # CAMBIA: contraseña segura

# ── Redis (usado para cache, sesiones, colas) ───────────────────────────────
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo SMTP ─────────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=tucorreo@gmail.com       # CAMBIA
MAIL_PASSWORD=                         # CAMBIA
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=tucorreo@gmail.com   # CAMBIA
MAIL_FROM_NAME="${APP_NAME}"

# ── Pusher / WebSockets (opcional, dejar vacio si no se usa) ───────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Multi-Tenant (hyn/multi-tenant) ────────────────────────────────────────
LIMIT_UUID_LENGTH_32=true
TENANCY_DATABASE_AUTO_DELETE=true
TENANCY_DATABASE_AUTO_DELETE_USER=true
PREFIX_DATABASE=tenancy

# ── Paginacion ──────────────────────────────────────────────────────────────
ITEMS_PER_PAGE=20
ITEMS_PER_PAGE_SIMPLE_D_TABLE=5
PASSWORD_CHANGE=true

# ── Firma Digital y OSE ─────────────────────────────────────────────────────
SIGNATURE_NOTE_OSE=FACTURALO
SIGNATURE_URI_OSE=signatureFACTURALOPERU
IS_CLIENT=false
TOKEN_SERVER=                          # Token interno entre servicios
URL_SERVER=                            # URL del servidor OSE (si aplica)

# ── Documentos ──────────────────────────────────────────────────────────────
RECREATE_DOCUMENT=false
IMPORT_DOCUMENTS=false
IMPORT_DOCUMENTS_SECOND_FORMAT=false
DELETE_DOCUMENT_TYPE_03=false
SELECT_FIRST_DOCUMENT_TYPE_03=false

# ── PDF ─────────────────────────────────────────────────────────────────────
PDF_TEMPLATE=default
PDF_TEMPLATE_FOOTER=true
PDF_NAME_REGULAR=false
PDF_NAME_BOLD=false
ENABLED_TEMPLATE_TICKET_80=false

# ── Descuentos / Estados ────────────────────────────────────────────────────
ENABLED_DISCOUNT_GLOBAL=false
CHANGE_TO_REGISTERED_STATUS=false
DOCUMENT_TYPE_03_FILTER=false
ADMIN_DELETE_CLIENT=false

# ── API de Consulta RUC/DNI (apiperu.dev o migo.pe) ────────────────────────
API_SERVICE_URL=https://apiperu.dev     # o https://api.migo.pe
API_SERVICE_TOKEN=CAMBIA_TU_TOKEN       # CAMBIA: token de consulta RUC/DNI

# ── SUNAT ───────────────────────────────────────────────────────────────────
SUNAT_ALTERNATE_SERVER=false
APIPERUDEV_VALIDATOR_CPE=true
VALIDATOR_CPE=false

# ── HTTPS ───────────────────────────────────────────────────────────────────
# Pon true si el Nginx externo ya termina SSL (recomendado)
# Pon true si el Nginx externo ya termina SSL (recomendado)
FORCE_HTTPS=false

# ── Extras ──────────────────────────────────────────────────────────────────
AUTO_PRINT=false
ALLOW_CLIENT_USE_OWN_APIPERU_TOKEN=false
WIKI_PHARMACY=${APP_URL}/docs/4.X/modulo-farmacia
