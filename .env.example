# =============================================================================
# Facturador Pro 6 - Configuracion para Produccion
# =============================================================================
# Copiar a .env y ajustar las variables marcadas como ⚠ REQUERIDO
# Las demas son opcionales y tienen valores por defecto funcionales.
# =============================================================================

# ╔══════════════════════════════════════════════════════════════╗
# ║  VARIABLES REQUERIDAS (DEBES CAMBIARLAS ANTES DE DEPLOYAR) ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Aplicacion ────────────────────────────────────────────────────────────
# ⚠ Generar con: php artisan key:generate --show (o docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));")
APP_KEY=

# ⚠ Tu dominio (sin http/https)
APP_URL_BASE=midominio.com

# ⚠ URL completa (https://tudominio.com)
APP_URL=https://midominio.com

# ── Base de Datos ─────────────────────────────────────────────────────────
# ⚠ Contraseña del usuario root de MySQL (cambiala por una segura)
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA

# ── Admin Inicial ─────────────────────────────────────────────────────────
# ⚠ El entrypoint crea automaticamente el admin con estas credenciales
ADMIN_EMAIL=admin@midominio.com
ADMIN_PASSWORD=123456

# ── API RUC/DNI ───────────────────────────────────────────────────────────
# ⚠ Token de consulta (apiperu.dev o api.migo.pe)
API_SERVICE_TOKEN=CAMBIA_TU_TOKEN

# ╔══════════════════════════════════════════════════════════════╗
# ║  VARIABLES CON VALORES POR DEFECTO (OPCIONALES)             ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Entorno ───────────────────────────────────────────────────────────────
APP_NAME="FacturadorPro6"
APP_ENV=production
APP_DEBUG=false
LOG_CHANNEL=daily

# ── Base de Datos (no cambiar a menos que sepas lo que haces) ────────────
DB_CONNECTION=system
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tenancy
DB_USERNAME=root

# ── Redis ─────────────────────────────────────────────────────────────────
BROADCAST_DRIVER=redis
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Correo SMTP ───────────────────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# ── Pusher / WebSockets ──────────────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ── Multi-Tenant (hyn/multi-tenant) ──────────────────────────────────────
LIMIT_UUID_LENGTH_32=true
TENANCY_DATABASE_AUTO_DELETE=true
TENANCY_DATABASE_AUTO_DELETE_USER=true
PREFIX_DATABASE=tenancy

# ── Paginacion ───────────────────────────────────────────────────────────
ITEMS_PER_PAGE=20
ITEMS_PER_PAGE_SIMPLE_D_TABLE=5
PASSWORD_CHANGE=true

# ── Firma Digital y OSE ──────────────────────────────────────────────────
SIGNATURE_NOTE_OSE=FACTURALO
SIGNATURE_URI_OSE=signatureFACTURALOPERU
IS_CLIENT=false
TOKEN_SERVER=
URL_SERVER=

# ── Documentos ───────────────────────────────────────────────────────────
RECREATE_DOCUMENT=false
IMPORT_DOCUMENTS=false
IMPORT_DOCUMENTS_SECOND_FORMAT=false
DELETE_DOCUMENT_TYPE_03=false
SELECT_FIRST_DOCUMENT_TYPE_03=false

# ── PDF ──────────────────────────────────────────────────────────────────
PDF_TEMPLATE=default
PDF_TEMPLATE_FOOTER=true
PDF_NAME_REGULAR=false
PDF_NAME_BOLD=false
ENABLED_TEMPLATE_TICKET_80=false

# ── Descuentos / Estados ─────────────────────────────────────────────────
ENABLED_DISCOUNT_GLOBAL=false
CHANGE_TO_REGISTERED_STATUS=false
DOCUMENT_TYPE_03_FILTER=false
ADMIN_DELETE_CLIENT=false

# ── API RUC/DNI (URL del proveedor) ──────────────────────────────────────
API_SERVICE_URL=https://apiperu.dev

# ── SUNAT ────────────────────────────────────────────────────────────────
SUNAT_ALTERNATE_SERVER=false
APIPERUDEV_VALIDATOR_CPE=true
VALIDATOR_CPE=false

# ── HTTPS ────────────────────────────────────────────────────────────────
# Pon true solo si el Nginx externo ya termina SSL
FORCE_HTTPS=false

# ── Extras ───────────────────────────────────────────────────────────────
AUTO_PRINT=false
ALLOW_CLIENT_USE_OWN_APIPERU_TOKEN=false
WIKI_PHARMACY=${APP_URL}/docs/4.X/modulo-farmacia
