{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.1",
        "barryvdh/laravel-dompdf": "^3.0",
        "binarytorch/larecipe": "^2.4",
        "culqi/culqi-php": "1.3.4",
        "fabpot/goutte": "^4.0",
        "fzaninotto/faker": "^1.4",
        "graham-campbell/markdown": "^15.0",
        "guzzlehttp/guzzle": "^7.0",
        "html2text/html2text": "^4.3",
        "hyn/multi-tenant": "5.*",
        "ifsnop/mysqldump-php": "^2.9",
        "imangazaliev/didom": "^1.13",
        "intervention/image": "^2.5",
        "laravel/framework": "^10.0",
        "laravel/legacy-factories": "^1.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^4.0",
        "laravelcollective/html": "^6.0",
        "maatwebsite/excel": "^3.1",
        "mercadopago/dx-php": "^3.0 <3.10",
        "mpdf/mpdf": "^8.0.0",
        "mpdf/qrcode": "^1.0",
        "nwidart/laravel-modules": "^5.0",
        "picqer/php-barcode-generator": "^2.0",
        "psr/log": "^2.0 || ^3.0",
        "rap2hpoutre/laravel-log-viewer": "^2.5",
        "robrichards/xmlseclibs": "3.0.*",
        "setasign/fpdf": "1.8.*",
        "setasign/fpdi": "^2.0",
        "symfony/process": "^6.0",
        "thiagoalessio/tesseract_ocr": "^2.7",
        "zanysoft/laravel-zip": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "filp/whoops": "^2.0",
        "laravel/dusk": "^7.0",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^6.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/seeds/tenants",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "modules/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "secure-http": false,
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "audit": {
            "ignore": ["true"]
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
