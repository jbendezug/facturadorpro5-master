node_modules/

# Dependencias
/vendor/

# Entorno — nunca subir al repo
.env
*.env
.env.local
.env.*.local

# Storage y cache generados
/storage/*.key
/storage/app/public
/storage/framework/cache/data/
/storage/framework/views/*.php
/bootstrap/cache/*.php

# Logs
*.log
/storage/logs/

# Debugbar cache (runtime, no debe estar en repo)
/storage/debugbar/
/storage/debugbar/*.json
/storage/debugbar/*.json.gz

# Assets compilados (se generan con npm run dev/prod)
/public/js/
/public/css/
/public/mix-manifest.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
